# MasterFabric Pre-Release Security Checker Makefile - Linux Version

CC = gcc
CFLAGS = -Wall -Wextra -std=c99 -O2 -g
LDFLAGS = -lm -lcurl -ljson-c
TARGET = masterfabric-prerelease
SRCDIR = src
INCDIR = include
OBJDIR = obj
BINDIR = bin

# Detect Linux distribution and set appropriate paths
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Linux)
    # Check for different package managers and set paths accordingly
    ifneq ($(shell which pacman 2>/dev/null),)
        # Arch Linux - use system paths
        CFLAGS += -I/usr/include
        LDFLAGS += -L/usr/lib
    else ifneq ($(shell which apt 2>/dev/null),)
        # Ubuntu/Debian - use system paths
        CFLAGS += -I/usr/include
        LDFLAGS += -L/usr/lib
    else ifneq ($(shell which dnf 2>/dev/null),)
        # Fedora - use system paths
        CFLAGS += -I/usr/include
        LDFLAGS += -L/usr/lib
    else ifneq ($(shell which zypper 2>/dev/null),)
        # openSUSE - use system paths
        CFLAGS += -I/usr/include
        LDFLAGS += -L/usr/lib
    else
        # Generic Linux - use system paths
        CFLAGS += -I/usr/include
        LDFLAGS += -L/usr/lib
    endif
endif

# Source files
SOURCES = $(wildcard $(SRCDIR)/*.c)
OBJECTS = $(SOURCES:$(SRCDIR)/%.c=$(OBJDIR)/%.o)

# Default target
all: $(BINDIR)/$(TARGET)

# Create directories
$(OBJDIR):
	mkdir -p $(OBJDIR)

$(BINDIR):
	mkdir -p $(BINDIR)

# Compile object files
$(OBJDIR)/%.o: $(SRCDIR)/%.c | $(OBJDIR)
	$(CC) $(CFLAGS) -I$(INCDIR) -c $< -o $@

# Link executable
$(BINDIR)/$(TARGET): $(OBJECTS) | $(BINDIR)
	$(CC) $(OBJECTS) -o $@ $(LDFLAGS)

# Install to system
install: $(BINDIR)/$(TARGET)
	cp $(BINDIR)/$(TARGET) /usr/local/bin/
	chmod +x /usr/local/bin/$(TARGET)

# Uninstall from system
uninstall:
	rm -f /usr/local/bin/$(TARGET)

# Clean build artifacts
clean:
	rm -rf $(OBJDIR) $(BINDIR)

# Run tests
test: $(BINDIR)/$(TARGET)
	@echo "Running security checker on Next.js demo application..."
	-cd ../cases/demo_vulnerable_app && ../../checker_tool/$(BINDIR)/$(TARGET) --check . --verbose
	@echo ""
	@echo "Running security checker on Flutter demo application..."
	-cd ../cases/demo_flutter_vulnerable_app && ../../checker_tool/$(BINDIR)/$(TARGET) --check . --verbose

# Debug build
debug: CFLAGS += -DDEBUG -g3
debug: $(BINDIR)/$(TARGET)

# Release build
release: CFLAGS += -DNDEBUG -O3
release: clean $(BINDIR)/$(TARGET)

# Check for required tools - Linux version
check-deps:
	@echo "Checking for required dependencies on Linux..."
	@echo "Distribution: $(shell lsb_release -d 2>/dev/null || echo "Unknown")"
	@which gcc > /dev/null && echo "✓ gcc found" || echo "✗ gcc not found - install with: sudo pacman -S gcc (Arch) or sudo apt install gcc (Ubuntu)"
	@which make > /dev/null && echo "✓ make found" || echo "✗ make not found - install with: sudo pacman -S make (Arch) or sudo apt install make (Ubuntu)"
	@which pkg-config > /dev/null && echo "✓ pkg-config found" || echo "✗ pkg-config not found - install with: sudo pacman -S pkg-config (Arch) or sudo apt install pkg-config (Ubuntu)"
	@which clang-tidy > /dev/null && echo "✓ clang-tidy found" || echo "✗ clang-tidy not found - install with: sudo pacman -S clang (Arch) or sudo apt install clang-tidy (Ubuntu)"
	@which cppcheck > /dev/null && echo "✓ cppcheck found" || echo "✗ cppcheck not found - install with: sudo pacman -S cppcheck (Arch) or sudo apt install cppcheck (Ubuntu)"
	@pkg-config --exists libcurl && echo "✓ libcurl found" || echo "✗ libcurl not found - install with: sudo pacman -S curl (Arch) or sudo apt install libcurl4-openssl-dev (Ubuntu)"
	@pkg-config --exists json-c && echo "✓ json-c found" || echo "✗ json-c not found - install with: sudo pacman -S json-c (Arch) or sudo apt install libjson-c-dev (Ubuntu)"
	@echo ""
	@echo "Linux-specific installation commands:"
	@echo "  Arch Linux:    sudo pacman -S base-devel gcc make pkg-config curl json-c clang cppcheck"
	@echo "  Ubuntu/Debian: sudo apt install build-essential gcc make pkg-config libcurl4-openssl-dev libjson-c-dev clang-tidy cppcheck"
	@echo "  Fedora:        sudo dnf install gcc make pkg-config libcurl-devel json-c-devel clang-tools-extra cppcheck"
	@echo "  openSUSE:      sudo zypper install gcc make pkg-config libcurl-devel libjson-c-devel clang-tools cppcheck"
	@echo "Dependencies check complete"

# Show help
help:
	@echo "MasterFabric Pre-Release Security Checker Build System - Linux Version"
	@echo ""
	@echo "Available targets:"
	@echo "  all       - Build the security checker (default)"
	@echo "  install   - Install to /usr/local/bin"
	@echo "  uninstall - Remove from /usr/local/bin"
	@echo "  clean     - Remove build artifacts"
	@echo "  test      - Run tests on demo application"
	@echo "  debug     - Build with debug symbols"
	@echo "  release   - Build optimized release version"
	@echo "  check-deps- Check for required dependencies (Linux-specific)"
	@echo "  help      - Show this help message"
	@echo ""
	@echo "Linux Installation:"
	@echo "  1. Install dependencies: make check-deps (shows commands for your distro)"
	@echo "  2. Build: make all"
	@echo "  3. Test: make test"
	@echo "  4. Install: sudo make install"

.PHONY: all install uninstall clean test debug release check-deps help
